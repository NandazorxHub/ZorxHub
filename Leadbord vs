--==================================================
-- DOUBLE TAP / DOUBLE CLICK LOCK
--==================================================

local Locked = false

local LastTap = 0
local DoubleTapDelay = 0.35

local Dragging = false
local DragStart
local StartPosition

local function RegisterTap()

    local CurrentTime = tick()

    if CurrentTime - LastTap <= DoubleTapDelay then

        -- LOCK / UNLOCK
        Locked = not Locked

        -- TIDAK ADA EMOJI
        -- TIDAK ADA PERUBAHAN TAMPILAN

        Dragging = false
        LastTap = 0

    else

        LastTap = CurrentTime

    end

end

--==================================================
-- DRAG START
--==================================================

Title.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        RegisterTap()

        local TapTime = LastTap

        task.delay(DoubleTapDelay, function()

            if TapTime == LastTap
            and not Locked
            and LastTap ~= 0 then

                Dragging = true

                DragStart = input.Position
                StartPosition = Board.Position

            end

        end)

    end

end)

--==================================================
-- DRAG UPDATE
--==================================================

UserInputService.InputChanged:Connect(function(input)

    if not Dragging then
        return
    end

    if Locked then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        local Delta = input.Position - DragStart

        Board.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,

            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )

    end

end)

--==================================================
-- DRAG END
--==================================================

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        Dragging = false

    end

end)

