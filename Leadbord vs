--==================================================
-- FIND VALUE
--==================================================

local function FindValue(player, names)

    local stats = player:FindFirstChild("leaderstats")

    if stats then

        for _, obj in ipairs(stats:GetChildren()) do

            if obj:IsA("NumberValue")
            or obj:IsA("IntValue") then

                local objectName = string.lower(obj.Name)

                for _, wanted in ipairs(names) do

                    if objectName == string.lower(wanted) then
                        return obj.Value
                    end

                end

            end

        end

    end

    -- PLAYER ATTRIBUTES
    for _, wanted in ipairs(names) do

        local value = player:GetAttribute(wanted)

        if typeof(value) == "number" then
            return value
        end

    end

    return 0

end

