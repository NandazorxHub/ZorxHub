--==================================================
-- UPDATE PLAYER
--==================================================

local function UpdatePlayer(player)

    local Data = Rows[player]

    if not Data then
        return
    end

    local Speed = FindValue(player, SpeedNames)
    local Money = FindValue(player, MoneyNames)

    Data.Speed.Text = FormatNumber(Speed)
    Data.Money.Text = FormatNumber(Money)

end

--==================================================
-- REFRESH
--==================================================

local function Refresh()

    for _, child in ipairs(List:GetChildren()) do

        if child:IsA("Frame") and child ~= BenRow then
            child:Destroy()
        end

    end

    Rows = {}

    for index, player in ipairs(Players:GetPlayers()) do

        CreateRow(player, index)
        UpdatePlayer(player)

    end

end

