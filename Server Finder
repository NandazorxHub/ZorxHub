-- =========================================================
-- GUI UPDATE
-- =========================================================

local function UpdateInfo()

	local blacklistCount = 0
	local candidateCount = 0

	for _ in pairs(Blacklist) do
		blacklistCount += 1
	end

	for _ in pairs(Candidates) do
		candidateCount += 1
	end

	Info.Text =
		"Dicoba: "
		.. totalTried
		.. " | Gagal: "
		.. totalFailed
		.. " | Kandidat: "
		.. candidateCount
		.. " | BL: "
		.. blacklistCount
end

local function SetStatus(text)
	Status.Text = text
end

-- =========================================================
-- BLACKLIST
-- =========================================================

local function CleanBlacklist()

	local now = os.clock()

	for jobId, expire in pairs(Blacklist) do
		if now >= expire then
			Blacklist[jobId] = nil
		end
	end

end

local function IsBlacklisted(jobId)

	CleanBlacklist()

	return jobId and Blacklist[jobId] ~= nil
end

local function BlacklistServer(jobId, reason)

	if not jobId then
		return
	end

	Blacklist[jobId] = os.clock() + BLACKLIST_TIME
	totalFailed += 1

	UpdateInfo()

	SetStatus(
		"🗑️ SERVER DIBUANG\n"
		.. string.sub(jobId, 1, 12)
		.. "...\n"
		.. tostring(reason or "Teleport gagal")
	)

end

-- =========================================================
-- GET SERVER PAGE
-- =========================================================

local function GetServers(cursor)

	local url =
		"https://games.roblox.com/v1/games/"
		.. PlaceId
		.. "/servers/Public?sortOrder=Asc&limit=100"

	if cursor then
		url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
	end

	local success, result = pcall(function()

		local response = game:HttpGet(url)

		return HttpService:JSONDecode(response)

	end)

	if not success then
		return nil
	end

	if not result or type(result.data) ~= "table" then
		return nil
	end

	return result
end

-- =========================================================
-- UPDATE CANDIDATES
-- =========================================================

local function ScanServers()

	local cursor = nil
	local page = 0

	local seenThisScan = {}

	repeat

		local data = GetServers(cursor)

		if not data then
			return false
		end

		page += 1

		for _, server in ipairs(data.data) do

			local jobId = server.id
			local playing = server.playing

			if
				jobId
				and jobId ~= game.JobId
				and playing == TARGET_PLAYERS
				and not IsBlacklisted(jobId)
			then

				seenThisScan[jobId] = true

				local candidate = Candidates[jobId]

				if candidate then

					candidate.observations += 1
					candidate.lastSeen = os.clock()

				else

					Candidates[jobId] = {
						observations = 1,
						firstSeen = os.clock(),
						lastSeen = os.clock(),
						maxPlayers = server.maxPlayers or 0
					}

				end

			end

		end

		cursor = data.nextPageCursor

		if cursor then
			task.wait(PAGE_DELAY)
		end

	until not cursor or page >= MAX_PAGES

	-- Kandidat yang tidak terlihat kali ini
	-- dihapus karena tidak bisa dianggap persistent.
	for jobId, candidate in pairs(Candidates) do

		if not seenThisScan[jobId] then
			Candidates[jobId] = nil
		end

	end

	UpdateInfo()

	return true
end

-- =========================================================
-- FIND MOST PERSISTENT 1-PLAYER SERVER
-- =========================================================

local function FindBestServer()

	local bestJobId = nil
	local bestCandidate = nil

	for jobId, candidate in pairs(Candidates) do

		if candidate.observations >= MIN_OBSERVATIONS then

			if
				not bestCandidate
				or candidate.observations > bestCandidate.observations
				or (
					candidate.observations == bestCandidate.observations
					and candidate.firstSeen < bestCandidate.firstSeen
				)
			then

				bestJobId = jobId
				bestCandidate = candidate

			end

		end

	end

	return bestJobId, bestCandidate
end

-- =========================================================
-- TELEPORT FAILURE
-- =========================================================

TeleportService.TeleportInitFailed:Connect(function(
	player,
	teleportResult,
	errorMessage
)

	if player ~= LocalPlayer then
		return
	end

	teleportFailed = true

	lastTeleportError =
		tostring(errorMessage or teleportResult)

end)

-- =========================================================
-- TELEPORT
-- =========================================================

local function TeleportToServer(jobId, candidate)

	if not jobId then
		return false, "JobId tidak valid"
	end

	if IsBlacklisted(jobId) then
		return false, "Server sudah blacklist"
	end

	teleportFailed = false
	lastTeleportError = nil

	totalTried += 1
	UpdateInfo()

	local duration =
		os.clock() - (candidate.firstSeen or os.clock())

	SetStatus(
		"🎯 SERVER PERSISTENT DITEMUKAN\n"
		.. "Player: 1\n"
		.. "Observasi: "
		.. tostring(candidate.observations)
		.. "\n"
		.. "Terlihat: "
		.. string.format("%.1f", duration)
		.. " detik"
	)

	task.wait(0.05)

	local success, errorMessage = pcall(function()

		TeleportService:TeleportToPlaceInstance(
			PlaceId,
			jobId,
			LocalPlayer
		)

	end)

	if not success then
		return false, tostring(errorMessage)
	end

	-- Tunggu hasil teleport
	for _ = 1, 50 do

		task.wait(0.1)

		if teleportFailed then
			return false, lastTeleportError
		end

		if game.JobId == jobId then
			return true
		end

	end

	if game.JobId == jobId then
		return true
	end

	return false, "Teleport tidak terkonfirmasi"
end

-- =========================================================
-- MAIN LOOP
-- =========================================================

local function StartFinder()

	if running then
		return
	end

	running = true

	totalTried = 0
	totalFailed = 0

	Candidates = {}
	Blacklist = {}

	StartButton.Active = false
	StartButton.Text = "🔎 MENCARI..."

	UpdateInfo()

	task.spawn(function()

		while running do

			CleanBlacklist()

			-- =============================================
			-- OBSERVE
			-- =============================================

			SetStatus(
				"🔎 Scan server 1 player...\n"
				.. "Mengamati server yang bertahan..."
			)

			local success = ScanServers()

			if not success then

				SetStatus(
					"⚠️ Gagal mengambil daftar server.\n"
					.. "Mencoba lagi..."
				)

				task.wait(RETRY_DELAY)

				continue
			end

			-- =============================================
			-- CHECK PERSISTENT SERVER
			-- =============================================

			local jobId, candidate =
				FindBestServer()

			if jobId and candidate then

				local duration =
					os.clock() - candidate.firstSeen

				SetStatus(
					"🎯 TARGET LOCKED!\n"
					.. "1 PLAYER\n"
					.. "Diamati "
					.. candidate.observations
					.. "x / "
					.. string.format("%.1f", duration)
					.. " detik"
				)

				local successTeleport, reason =
					TeleportToServer(jobId, candidate)

				if successTeleport then

					SetStatus(
						"✅ BERHASIL REJOIN\n"
						.. "Target: 1 PLAYER"
					)

					running = false

					return
				end

				-- Teleport gagal
				BlacklistServer(
					jobId,
					reason or "Teleport gagal"
				)

				Candidates[jobId] = nil

				task.wait(RETRY_DELAY)

			else

				local candidateCount = 0

				for _ in pairs(Candidates) do
					candidateCount += 1
				end

				SetStatus(
					"⏳ Belum ada server persistent.\n"
					.. "Kandidat aktif: "
					.. candidateCount
					.. "\n"
					.. "Observasi "
					.. MIN_OBSERVATIONS
					.. "x diperlukan."
				)

				task.wait(OBSERVE_DELAY)

			end

		end

	end)

end

