-- =========================================================
-- UPDATE LIST
-- =========================================================

local function UpdateServerList()
	ClearServerList()

	local count = 0

	for jid in pairs(Candidates) do
		if count >= MAX_DISPLAY_SERVERS then
			break
		end

		if not IsBlacklisted(jid) then
			AddServer(jid)
			count += 1
		end
	end

	UpdateInfo()
end

-- =========================================================
-- FETCH
-- =========================================================

local function FetchServers(cursor)
	local url =
		"https://games.roblox.com/v1/games/" ..
		PlaceId ..
		"/servers/Public?sortOrder=Asc&limit=100"

	if cursor then
		url ..=
			"&cursor=" ..
			HttpService:UrlEncode(cursor)
	end

	local ok, result = pcall(function()
		return HttpService:JSONDecode(
			game:HttpGet(url)
		)
	end)

	if not ok or not result or not result.data then
		return nil
	end

	return result
end

-- =========================================================
-- SCAN
-- =========================================================

local function Scan()
	Candidates = {}
	selectedServer = nil

	SelectedLabel.Text = "Belum memilih server"
	SelectedLabel.TextColor3 =
		Color3.fromRGB(145, 145, 155)

	JoinBtn.Text = "JOIN SERVER YANG DIPILIH"
	JoinBtn.BackgroundColor3 =
		Color3.fromRGB(70, 70, 80)

	ClearServerList()

	local cursor = nil
	local page = 0

	repeat
		local data = FetchServers(cursor)

		if not data then
			return false
		end

		page += 1

		for _, server in ipairs(data.data) do
			local jid = server.id
			local players = server.playing

			if jid
				and jid ~= game.JobId
				and players == TARGET_EXACT
				and not IsBlacklisted(jid)
			then
				Candidates[jid] = {
					firstSeen = os.clock(),
					count = 1,
					lastCheck = os.clock()
				}
			end
		end

		cursor = data.nextPageCursor

		if cursor and page < MAX_PAGES then
			task.wait(PAGE_DELAY)
		end

	until not cursor or page >= MAX_PAGES

	UpdateServerList()

	local count = 0

	for _ in pairs(Candidates) do
		count += 1
	end

	if count > 0 then
		SetStatus(
			"✅ DITEMUKAN " ..
			count ..
			" SERVER\n" ..
			"Pilih server atau gunakan AUTO JOIN"
		)
	else
		SetStatus(
			"⏳ TIDAK ADA SERVER 1 ORANG\n" ..
			"Coba scan lagi"
		)
	end

	return count > 0
end

-- =========================================================
-- TELEPORT
-- =========================================================

local function TeleportToServer(jid)
	if not jid or IsBlacklisted(jid) then
		return false
	end

	teleporting = true

	totalTry += 1
	UpdateInfo()

	SetStatus(
		"🚀 JOINING SERVER...\n" ..
		"Server: " ..
		string.sub(tostring(jid), 1, 18)
	)

	local failed = false
	local errorMessage

	local connection

	connection = TeleportService.TeleportInitFailed:Connect(
		function(player, _, err)
			if player == LocalPlayer then
				failed = true
				errorMessage = tostring(err)

				if connection then
					connection:Disconnect()
					connection = nil
				end
			end
		end
	)

	local ok, err = pcall(function()
		TeleportService:TeleportToPlaceInstance(
			PlaceId,
			jid,
			LocalPlayer
		)
	end)

	if not ok then
		if connection then
			connection:Disconnect()
		end

		teleporting = false

		Blacklist[jid] =
			os.clock() + BLACKLIST_DURATION

		SetStatus(
			"❌ TELEPORT GAGAL\n" ..
			tostring(err)
		)

		return false
	end

	for _ = 1, 50 do
		task.wait(0.1)

		if failed then
			if connection then
				connection:Disconnect()
			end

			teleporting = false

			Blacklist[jid] =
				os.clock() + BLACKLIST_DURATION

			SetStatus(
				"❌ GAGAL JOIN\n" ..
				tostring(errorMessage or "server berubah")
			)

			return false
		end

		if game.JobId == jid then
			if connection then
				connection:Disconnect()
			end

			totalOK += 1
			UpdateInfo()

			SetStatus(
				"🎉 BERHASIL MASUK!\n" ..
				"Server pilihan berhasil dimasuki"
			)

			return true
		end
	end

	if connection then
		connection:Disconnect()
	end

	teleporting = false

	Blacklist[jid] =
		os.clock() + BLACKLIST_DURATION

	SetStatus("❌ TIMEOUT\nServer tidak dapat dimasuki")

	return false
end

