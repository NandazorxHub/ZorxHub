local function SetStatus(text)
	Status.Text = text
end

local function UpdateInfo()
	local count = 0

	for _ in pairs(Candidates) do
		count += 1
	end

	Info.Text =
		"Dicoba: " ..
		totalTry ..
		"   •   Berhasil: " ..
		totalOK ..
		"   •   Server: " ..
		count
end

local function CleanBlacklist()
	local now = os.clock()

	for jid, expire in pairs(Blacklist) do
		if now >= expire then
			Blacklist[jid] = nil
		end
	end
end

local function IsBlacklisted(jid)
	return Blacklist[jid] ~= nil
end

local function ClearServerList()
	for _, child in ipairs(ServerList:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
end

