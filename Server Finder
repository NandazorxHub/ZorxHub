-- =========================================================
-- AUTO JOIN
-- =========================================================

local function AutoJoin()
	if running or teleporting then
		return
	end

	running = true
	selectedServer = nil

	ScanBtn.Active = false
	AutoBtn.Active = false
	JoinBtn.Active = false

	AutoBtn.Text = "⛔ STOP AUTO"

	SetStatus(
		"⚡ AUTO JOIN AKTIF\n" ..
		"Mencari dan masuk otomatis..."
	)

	task.spawn(function()
		while running and not teleporting do
			CleanBlacklist()

			local found = Scan()

			if found then
				-- Ambil salah satu server yang ditemukan.
				-- Tidak perlu user memilih.
				local target = nil

				for jid in pairs(Candidates) do
					if not IsBlacklisted(jid) then
						target = jid
						break
					end
				end

				if target then
					SetStatus(
						"⚡ AUTO JOIN\n" ..
						"Server 1 player ditemukan"
					)

					local success = TeleportToServer(target)

					if success then
						running = false
						return
					end
				end
			end

			if running and not teleporting then
				SetStatus(
					"🔎 AUTO JOIN...\n" ..
					"Belum berhasil, mencari lagi..."
				)

				task.wait(AUTO_SCAN_DELAY)
			end
		end

		running = false

		ScanBtn.Active = true
		AutoBtn.Active = true
		JoinBtn.Active = true

		AutoBtn.Text = "⚡ AUTO JOIN"
	end)
end

AutoBtn.MouseButton1Click:Connect(function()
	if teleporting then
		return
	end

	if running then
		running = false

		ScanBtn.Active = true
		AutoBtn.Active = true
		JoinBtn.Active = true

		AutoBtn.Text = "⚡ AUTO JOIN"

		SetStatus(
			"⏹ AUTO JOIN DIHENTIKAN\n" ..
			"Server tidak akan dimasuki otomatis"
		)

		return
	end

	AutoJoin()
end)

