-- =========================================================
-- STATUS
-- =========================================================

local function SetStatus(text)
	Status.Text = text
end

local function UpdateInfo()
	local jumlahBlacklist = 0

	for _ in pairs(Blacklist) do
		jumlahBlacklist += 1
	end

	Info.Text =
    "Bypas: "
    .. totalDicoba
    .. " | Gagal: "
    .. totalGagal
    .. " | Dibuang: "
    .. jumlahBlacklist
end

-- =========================================================
-- BLACKLIST
-- =========================================================

local function BersihkanBlacklist()

	local sekarang = os.clock()

	for jobId, expireTime in pairs(Blacklist) do

		if sekarang >= expireTime then
			Blacklist[jobId] = nil
		end

	end

end

local function BuangServer(jobId, alasan)

	if not jobId then
		return
	end

	Blacklist[jobId] = os.clock() + WAKTU_BLACKLIST

	totalGagal += 1

	UpdateInfo()

	SetStatus(
		"🗑️ Server dibuang\n"
		.. string.sub(jobId, 1, 12)
		.. "...\n"
		.. tostring(alasan or "Teleport gagal")
	)

end

local function ServerDibuang(jobId)

	BersihkanBlacklist()

	if not jobId then
		return true
	end

	return Blacklist[jobId] ~= nil
end

-- =========================================================
-- AMBIL SERVER
-- =========================================================

local function AmbilServer(cursor)

	local url =
		"https://games.roblox.com/v1/games/"
		.. PlaceId
		.. "/servers/Public?sortOrder=Asc&limit=100"

	if cursor then
		url =
			url
			.. "&cursor="
			.. HttpService:UrlEncode(cursor)
	end

	local success, result = pcall(function()

		local response = game:HttpGet(url)

		return HttpService:JSONDecode(response)

	end)

	if not success then
		return nil
	end

	if not result or not result.data then
		return nil
	end

	return result

end

-- =========================================================
-- VALIDASI SERVER
-- =========================================================

local function ServerCocok(server, batas)

	if not server then
		return false
	end

	if not server.id then
		return false
	end

	-- Jangan masuk server sekarang
	if server.id == game.JobId then
		return false
	end

	-- Jangan mencoba server yang sudah dibuang
	if ServerDibuang(server.id) then
		return false
	end

	-- Data jumlah pemain harus valid
	if type(server.playing) ~= "number" then
		return false
	end

	-- BATAS UTAMA
	if server.playing > batas then
		return false
	end

	-- Pastikan server belum penuh
	if type(server.maxPlayers) == "number" then

		if server.playing >= server.maxPlayers then
			return false
		end

	end

	return true

end

-- =========================================================
-- CARI SERVER
-- =========================================================

local function CariServer(batas)

	local kandidat = {}

	local cursor = nil
	local halaman = 0

	repeat

		local data = AmbilServer(cursor)

		if not data then
			return nil
		end

		halaman += 1

		for _, server in ipairs(data.data) do

			if ServerCocok(server, batas) then

				table.insert(kandidat, server)

			end

		end

		cursor = data.nextPageCursor

		if cursor then
			task.wait(JEDA_HALAMAN)
		end

	until not cursor or halaman >= MAKS_HALAMAN

	-- Tidak ada kandidat
	if #kandidat == 0 then
		return nil
	end

	-- =====================================================
	-- PILIH SERVER PALING SEPI
	-- =====================================================

	table.sort(kandidat, function(a, b)

		if a.playing == b.playing then
			return tostring(a.id) < tostring(b.id)
		end

		return a.playing < b.playing

	end)

	-- Kandidat pertama adalah yang paling sedikit pemain
	return kandidat[1]

end

-- =========================================================
-- TELEPORT FAILURE
-- =========================================================

TeleportService.TeleportInitFailed:Connect(
	function(player, teleportResult, errorMessage)

		if player ~= LocalPlayer then
			return
		end

		teleportFailed = true

		lastTeleportError =
			tostring(errorMessage or teleportResult)

	end
)

-- =========================================================
-- TELEPORT
-- =========================================================

local function TeleportKeServer(server)

	if not server or not server.id then
		return false, "Server tidak valid"
	end

	-- Cek blacklist sekali lagi
	if ServerDibuang(server.id) then
		return false, "Server sudah dibuang"
	end

	teleportFailed = false
	lastTeleportError = nil

	totalDicoba += 1
	UpdateInfo()

	SetStatus(
		"🚀 Teleport...\n"
		.. tostring(server.playing)
		.. "/"
		.. tostring(server.maxPlayers or "?")
		.. " pemain\n"
		.. string.sub(server.id, 1, 12)
		.. "..."
	)

	local success, errorMessage = pcall(function()

		TeleportService:TeleportToPlaceInstance(
			PlaceId,
			server.id,
			LocalPlayer
		)

	end)

	-- Panggilan Teleport sendiri gagal
	if not success then

		return false, tostring(errorMessage)

	end

	-- Tunggu hasil TeleportInitFailed
	for i = 1, 50 do

		task.wait(0.1)

		-- Teleport failure
		if teleportFailed then

			return false, lastTeleportError

		end

		-- Sudah benar-benar berada di JobId target
		if game.JobId == server.id then

			return true, nil

		end

	end

	-- Tidak ada konfirmasi
	if game.JobId == server.id then
		return true, nil
	end

	return false, "Teleport tidak memberikan konfirmasi"

end

-- =========================================================
-- MULAI
-- =========================================================

local function MulaiCari()

	if sedangJalan then
		return
	end

	local batas = tonumber(InputMaks.Text)

	if not batas then

		SetStatus("❌ Masukkan angka yang valid.")

		return
	end

	batas = math.floor(batas)
	batas = math.max(1, batas)

	-- Reset statistik
	totalDicoba = 0
	totalGagal = 0

	Blacklist = {}

	sedangJalan = true

	btnMulai.Active = false
	btnMulai.Text = "🔎 MENCARI..."

	UpdateInfo()

	task.spawn(function()

		while sedangJalan do

			BersihkanBlacklist()
			UpdateInfo()

			SetStatus(
				"🔎 Mencari server ≤ "
				.. batas
				.. " pemain..."
			)

			local target = CariServer(batas)

			-- =================================================
			-- TIDAK ADA TARGET
			-- =================================================

			if not target then

				SetStatus(
					"🔄 Tidak ada server ≤ "
					.. batas
					.. ".\nMencari halaman berikutnya..."
				)

				task.wait(JEDA_CARI_LAGI)

				continue
			end

			-- =================================================
			-- TARGET DITEMUKAN
			-- =================================================

			SetStatus(
				"🎯 Target ditemukan!\n"
				.. tostring(target.playing)
				.. "/"
				.. tostring(target.maxPlayers or "?")
				.. " pemain"
			)

			task.wait(0.05)

			local berhasil, alasan =
				TeleportKeServer(target)

			-- =================================================
			-- BERHASIL
			-- =================================================

			if berhasil then

				SetStatus(
					"✅ BERHASIL!\n"
					.. tostring(target.playing)
					.. " pemain"
				)

				sedangJalan = false

				return

			end

			-- =================================================
			-- GAGAL -> BUANG SERVER
			-- =================================================

			BuangServer(
				target.id,
				alasan or "Teleport gagal"
			)

			task.wait(JEDA_CARI_LAGI)

		end

	end)

end

