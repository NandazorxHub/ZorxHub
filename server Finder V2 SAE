-- TELEPORT (FIX: notifikasi gagal jelas)
-- =========================================================

local function TeleportToServer(jid)
    if not jid or IsBlacklisted(jid) then return false end

    teleporting = true
    totalTry += 1
    UpdateInfo()

    local eggScore = ServerEggScores[jid] or 0
    SetStatus("🚀 JOINING...\nEgg Score: " .. math.floor(eggScore))

    local failed = false
    local errorMessage

    local connection
    connection = TeleportService.TeleportInitFailed:Connect(function(player, _, err)
        if player == LocalPlayer then
            failed = true
            errorMessage = tostring(err)
            if connection then
                connection:Disconnect()
                connection = nil
            end
        end
    end)

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, jid, LocalPlayer)
    end)

    if not ok then
        if connection then connection:Disconnect() end
        teleporting = false
        Blacklist[jid] = os.clock() + FAILED_SERVER_DURATION
        SetStatus("❌ TELEPORT GAGAL\n" .. tostring(err))
        return false
    end

    for _ = 1, TELEPORT_WAIT do
        task.wait(0.05)

        if failed then
            if connection then connection:Disconnect() end
            teleporting = false
            Blacklist[jid] = os.clock() + FAILED_SERVER_DURATION
            SetStatus("❌ SERVER GAGAL / PENUH\n" .. tostring(errorMessage or "full"))
            return false
        end

        if game.JobId == jid then
            if connection then connection:Disconnect() end
            totalOK += 1
            UpdateInfo()
            SetStatus("🎉 MASUK!\nCek egg rare...")
            return true
        end
    end

    if connection then connection:Disconnect() end
    teleporting = false
    Blacklist[jid] = os.clock() + FAILED_SERVER_DURATION
    SetStatus("❌ TIMEOUT TELEPORT")
    return false
end

-- =========================================================
-- CEK EGG SETELAH JOIN
-- =========================================================

local function WaitForRareEgg()
    local startWait = os.clock()

    while (os.clock() - startWait) < EGG_CHECK_WAIT do
        local hasRare, best = HasRareEggRemaining()
        if hasRare then
            return true, best
        end
        task.wait(EGG_CHECK_INTERVAL)
    end

    local _, best = HasRareEggRemaining()
    return false, best
end

local function FindNextTarget(excludeJid)
    local bestJid = nil
    local bestScore = -1

    for jid, data in pairs(Candidates) do
        if jid ~= excludeJid
            and not IsBlacklisted(jid)
            and (data.eggScore or 0) > bestScore
        then
            bestScore = data.eggScore
            bestJid = jid
        end
    end

    return bestJid
end

local function JoinAndVerify(jid)
    local success = TeleportToServer(jid)
    if not success then
        Blacklist[jid] = os.clock() + FAILED_SERVER_DURATION
        return false
    end

    task.wait(2)

    SetStatus("🔍 CEK EGG DIVINE/SECRET/ETERNAL...\nTunggu max " .. EGG_CHECK_WAIT .. "s")

    local hasRare, best = WaitForRareEgg()

    if hasRare then
        SetStatus("✅ EGG RARE ADA!\n" ..
            best.name .. " [" .. best.tier .. "]\n" ..
            "Size: " .. math.floor(best.volume) .. " • BELUM DIAMBIL")
        return true
    else
        Blacklist[jid] = os.clock() + 30
        totalSkipped += 1
        UpdateInfo()

        SetStatus("❌ EGG RARE SUDAH DIAMBIL / HABIS\nServer: " .. string.sub(jid, 1, 12) .. "\nPindah...")
        return false
    end
end

