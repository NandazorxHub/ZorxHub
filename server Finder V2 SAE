-- =========================================================
-- EGG DETECTION (FIX: detect egg yang BELUM DIAMBIL)
-- =========================================================

-- Cek apakah egg masih "tersedia" (belum diambil)
-- Egg yang belum diambil biasanya: masih ada di workspace, visible, tidak di-hold player
local function IsEggAvailable(obj)
    -- Cek visibility
    local ok, transparency = pcall(function() return obj.Transparency end)
    if ok and transparency and transparency >= 1 then return false end

    -- Cek apakah ada di workspace dan tidak di parent ke player/backpack
    if obj:IsDescendantOf(game.Players) then return false end

    -- Cek attribute umum "taken" / "claimed"
    local takenAttr = obj:GetAttribute("Taken") or obj:GetAttribute("Claimed")
        or obj:GetAttribute("TakenBy") or obj:GetAttribute("Owner")
    if takenAttr ~= nil then
        if typeof(takenAttr) == "boolean" and takenAttr then return false end
        if typeof(takenAttr) == "string" and takenAttr ~= "" then return false end
    end

    -- Cek apakah di-hold player (Weld/Attachment ke character)
    local parent = obj.Parent
    if parent and (parent:IsA("Tool") or parent:IsA("Accessory")) then return false end

    -- Cek humanoid di sekitar (egg biasanya diam, kalau gerak mungkin udah diambil)
    if obj:IsA("BasePart") then
        local ok2, vel = pcall(function() return obj.AssemblyLinearVelocity end)
        if ok2 and vel and vel.Magnitude > 50 then return false end
    end

    return true
end

local function ScoreEgg(obj)
    if not IsEggAvailable(obj) then return nil end

    local ok, size = pcall(function() return obj.Size end)
    if not ok or typeof(size) ~= "Vector3" then return nil end

    local vol = size.X * size.Y * size.Z
    if vol < EGG_MIN_SIZE then return nil end

    local name = string.lower(obj.Name)
    local tier = "unknown"
    local score = 0
    local priority = 999
    local isRare = false

    for idx, keyword in ipairs(EGG_PRIORITY) do
        if string.find(name, keyword) then
            tier = keyword
            score = EGG_TIERS[keyword] or 50
            priority = idx
            break
        end
    end

    for _, kw in ipairs(RARE_EGG_KEYWORDS) do
        if string.find(name, kw) then
            isRare = true
            break
        end
    end

    if score == 0 then
        if vol > 8000 then score = 65
        elseif vol > 3000 then score = 45
        elseif vol > 800 then score = 25
        else score = 10 end
        priority = 100
    end

    return {
        name = obj.Name, tier = tier, score = score,
        volume = vol, size = size, object = obj,
        priority = priority, isRare = isRare,
    }
end

local function ScanBiggestEggInWorkspace()
    local best = nil
    local bestPriority = 999
    local bestVol = 0

    local function checkChildren(parent, depth)
        if depth > 4 then return end
        for _, child in ipairs(parent:GetChildren()) do
            local egg = ScoreEgg(child)
            if egg then
                local pick = false
                if egg.isRare and (best == nil or not best.isRare) then
                    pick = true
                elseif egg.isRare == (best and best.isRare) then
                    if egg.priority < bestPriority then
                        pick = true
                    elseif egg.priority == bestPriority and egg.volume > bestVol then
                        pick = true
                    end
                end

                if pick then
                    bestPriority = egg.priority
                    bestVol = egg.volume
                    best = egg
                end
            end

            if (child:IsA("Model") or child:IsA("Folder") or child:IsA("Tool")) and depth < 4 then
                checkChildren(child, depth + 1)
            end
        end
    end

    local found = false
    for _, obj in ipairs(game.Workspace:GetChildren()) do
        local lname = string.lower(obj.Name)
        for _, key in ipairs(EGG_FOLDER_NAMES) do
            if string.find(lname, key) then
                checkChildren(obj, 1)
                found = true
                break
            end
        end
    end

    if not found then
        checkChildren(game.Workspace, 0)
    end

    BestEgg = best
    return best
end

-- Cek apakah ada RARE egg (divine/secret/eternal) yang BELUM DIAMBIL
local function HasRareEggRemaining()
    local best = ScanBiggestEggInWorkspace()
    if best and best.isRare then
        return true, best
    end
    return false, best
end

-- =========================================================
-- EGG SCORE PREDICTION
-- =========================================================

local function HashJID(jid)
    local hash = 0
    for i = 1, #jid do
        hash = (hash * 31 + string.byte(jid, i)) % 1000000
    end
    return hash
end

local function PredictEggScore(jid, serverData)
    local hash = HashJID(jid)
    local base = 60 + (hash % 40)

    local region = string.lower(tostring(serverData.region or ""))
    local regionBonus = 0
    for r, val in pairs(PREFERRED_REGIONS) do
        if string.find(region, r) then
            regionBonus = val
            break
        end
    end

    local uptimeBonus = 0
    local uptime = serverData.uptime or 0
    if uptime < 300 then uptimeBonus = 15
    elseif uptime < 1800 then uptimeBonus = 8
    elseif uptime < 3600 then uptimeBonus = 4 end

    local pingBonus = 0
    local ping = serverData.ping or 999
    if ping < 60 then pingBonus = 10
    elseif ping < 100 then pingBonus = 6
    elseif ping < 150 then pingBonus = 3 end

    return math.min(base + regionBonus + uptimeBonus + pingBonus, 200)
end

