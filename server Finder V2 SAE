-- FETCH (FIX: hanya 1 PLAYER)
-- =========================================================

local function BuildURL(cursor)
    local url = "https://games.roblox.com/v1/games/" .. PlaceId ..
        "/servers/Public?sortOrder=Asc&limit=100"
    if cursor then
        url ..= "&cursor=" .. HttpService:UrlEncode(cursor)
    end
    return url
end

local function FetchFast(url)
    local ok, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if ok and res then return res end
    return nil
end

local function processList(list)
    for _, server in ipairs(list) do
        local jid = server.id
        local players = server.playing
        -- FIX: HANYA 1 player di server
        if jid and jid ~= game.JobId
            and players == TARGET_EXACT
            and not IsBlacklisted(jid)
        then
            local eggScore = PredictEggScore(jid, server)
            ServerEggScores[jid] = eggScore
            Candidates[jid] = {
                firstSeen = os.clock(),
                lastCheck = os.clock(),
                score = eggScore,
                region = server.region,
                ping = server.ping,
                uptime = server.uptime,
                eggScore = eggScore,
            }
        end
    end
end

