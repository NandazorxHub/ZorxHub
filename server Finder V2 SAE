-- =========================================================
-- AUTO JOIN (FIX: 1 player target + best server warna kuning prioritas)
-- =========================================================

local function AutoJoin()
    if running or teleporting then return end

    running = true
    selectedServer = nil

    ScanBtn.Active = false
    AutoBtn.Active = false
    JoinBtn.Active = false
    AutoBtn.Text = "⛔ STOP AUTO"

    SetStatus("⚡ AUTO JOIN\nCari server 1 player + egg rare...")

    task.spawn(function()
        while running do
            CleanBlacklist()

            SetStatus("🔎 SCAN SERVER 1 PLAYER...")
            local found = Scan()

            if not found then
                SetStatus("⏳ 0 SERVER 1 PLAYER\nTunggu...")
                task.wait(AUTO_SCAN_DELAY)
                continue
            end

            -- Prioritas: server BEST (kuning) = score tertinggi
            local targets = {}
            for jid, data in pairs(Candidates) do
                if not IsBlacklisted(jid) then
                    table.insert(targets, { jid = jid, score = data.eggScore or 0 })
                end
            end
            table.sort(targets, function(a, b) return a.score > b.score end)

            local gotIt = false

            for _, entry in ipairs(targets) do
                if not running then break end

                SetStatus("⚡ COBA JOIN (1 PLAYER)\nEgg Score: " .. math.floor(entry.score) ..
                    (entry.jid == BestServer and "\n⭐ BEST SERVER" or ""))

                local ok = JoinAndVerify(entry.jid)
                if ok then
                    gotIt = true
                    break
                end

                SetStatus("⏭️ GAGAL / EGG HABIS\nPindah ke server berikutnya...")
                task.wait(0.3)
            end

            if gotIt then
                SetStatus("🎉 BERHASIL!\nEgg divine/secret/eternal ada & belum diambil")
                running = false
                break
            end

            if running then
                SetStatus("🔎 SEMUA KANDIDAT HABIS\nScan ulang...")
                task.wait(0.2)
            end
        end

        running = false
        ScanBtn.Active = true
        AutoBtn.Active = true
        JoinBtn.Active = true
        AutoBtn.Text = "⚡ AUTO JOIN"
    end)
end

AutoBtn.MouseButton1Click:Connect(function()
    if teleporting then return end

