        running = false
        ScanBtn.Active = true
        AutoBtn.Active = true
        JoinBtn.Active = true
        AutoBtn.Text = "⚡ AUTO JOIN"
        SetStatus("⏹ STOPPED")
        return
    end

    AutoJoin()
end)

