local function UpdateServerList()
    ClearServerList()

    local sorted = {}
    for jid, data in pairs(Candidates) do
        if not IsBlacklisted(jid) then
            table.insert(sorted, { jid = jid, data = data })
        end
    end

    -- Sort by eggScore DESC
    table.sort(sorted, function(a, b)
        return (a.data.eggScore or 0) > (b.data.eggScore or 0)
    end)

    -- Set BestServer = score tertinggi
    BestServer = sorted[1] and sorted[1].jid or nil

    local count = 0
    for _, entry in ipairs(sorted) do
        if count >= MAX_DISPLAY_SERVERS then break end
        local isBest = (entry.jid == BestServer)
        AddServer(entry.jid, entry.data, isBest)
        count += 1
    end

    UpdateInfo()
end

-- =========================================================
-- SCAN (ULTRA CEPAT — 1 HALAMAN DULU)
-- =========================================================

local function Scan()
    local scanStart = os.clock()

    Candidates = {}
    selectedServer = nil
    BestServer = nil
    ServerEggScores = {}

    SelectedLabel.Text = "Belum memilih server"
    SelectedLabel.TextColor3 = Color3.fromRGB(145, 145, 155)
    JoinBtn.Text = "JOIN SERVER YANG DIPILIH"
    JoinBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 80)

    ClearServerList()

    local first = FetchFast(BuildURL(nil))
    if not first or not first.data then
        SetStatus("❌ GAGAL FETCH")
        return false
    end

    processList(first.data)
    UpdateServerList()

    if first.nextPageCursor then
        task.spawn(function()
            local cursor = first.nextPageCursor
            local page = 1

            while cursor and page < MAX_PAGES do
                page += 1
                local data = FetchFast(BuildURL(cursor))
                if not data or not data.data then break end

                processList(data.data)
                UpdateServerList()

                cursor = data.nextPageCursor
                if not cursor then break end
            end
        end)
    end

    local count = 0
    for _ in pairs(Candidates) do count += 1 end

    local elapsed = string.format("%.2f", os.clock() - scanStart)

    if count > 0 then
        SetStatus("✅ " .. count .. " SERVER 1 PLAYER (" .. elapsed .. "s)")
    else
        SetStatus("⏳ 0 SERVER 1 PLAYER (" .. elapsed .. "s)")
    end

    return count > 0
end

