--========================================================
-- CREATE ANIMATION
--========================================================

local function createAnimation(
	animator,
	id,
	looped,
	priority
)

	local animation =
		Instance.new("Animation")

	animation.AnimationId =
		"rbxassetid://" .. tostring(id)

	local track

	local success =
		pcall(function()

			track =
				animator:LoadAnimation(
					animation
				)

		end)

	if not success or not track then

		animation:Destroy()

		return nil

	end

	track.Looped = looped
	track.Priority = priority

	animation:Destroy()

	return track

end

--========================================================
-- ANIMATION SYSTEM
--========================================================

local function setupAnimationSystem(character)

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid then
		return nil
	end

	local animator =
		humanoid:FindFirstChildOfClass(
			"Animator"
		)

	if not animator then

		animator =
			Instance.new("Animator")

		animator.Parent =
			humanoid

	end

	local idleTrack =
		createAnimation(
			animator,
			507766666,
			true,
			Enum.AnimationPriority.Idle
		)

	local walkTrack =
		createAnimation(
			animator,
			507777826,
			true,
			Enum.AnimationPriority.Movement
		)

	local runTrack =
		createAnimation(
			animator,
			507767714,
			true,
			Enum.AnimationPriority.Movement
		)

	local animate =
		character:FindFirstChild("Animate")

	if animate then
		animate.Disabled = true
	end

	if idleTrack then
		idleTrack:Play(0.25)
	end

	return {
		idle = idleTrack,
		walk = walkTrack,
		run = runTrack
	}

end

--========================================================
-- IDLE
--========================================================

local function playIdle(tracks)

	if not tracks then
		return
	end

	if tracks.walk then
		tracks.walk:Stop(0.2)
	end

	if tracks.run then
		tracks.run:Stop(0.2)
	end

	if tracks.idle
		and not tracks.idle.IsPlaying then

		tracks.idle:Play(0.25)

	end

end

--========================================================
-- WALK
--========================================================

local function playWalk(tracks)

	if not tracks then
		return
	end

	if tracks.idle
		and tracks.idle.IsPlaying then

		tracks.idle:Stop(0.2)

	end

	if tracks.run then
		tracks.run:Stop(0.2)
	end

	if tracks.walk
		and not tracks.walk.IsPlaying then

		tracks.walk:Play(0.2)

	end

end

--========================================================
-- PATH WALK
--========================================================

local function walkToPosition(
	character,
	destination,
	token
)

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid or not root then
		return
	end

	if token ~= movementToken then
		return
	end

	local path =
		PathfindingService:CreatePath({

			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = false,
			WaypointSpacing = 4

		})

	local success =
		pcall(function()

			path:ComputeAsync(
				root.Position,
				destination
			)

		end)

	if not success
		or path.Status
			~= Enum.PathStatus.Success then

		humanoid:MoveTo(destination)

		task.wait(2)

		return

	end

	local waypoints =
		path:GetWaypoints()

	for _, waypoint
		in ipairs(waypoints) do

		if token ~= movementToken then
			return
		end

		if not character.Parent then
			return
		end

		if humanoid.Health <= 0 then
			return
		end

		if not movementEnabled then
			return
		end

		humanoid:MoveTo(
			waypoint.Position
		)

		local reached = false

		local connection

		connection =
			humanoid.MoveToFinished:Connect(
				function()

					reached = true

				end
			)

		local timeout =
			os.clock() + 5

		while not reached
			and os.clock() < timeout do

			if token ~= movementToken then
				break
			end

			if not movementEnabled then
				break
			end

			task.wait(0.1)

		end

		connection:Disconnect()

	end

end

--========================================================
-- NATURAL MOVEMENT
--========================================================

local function startNaturalMovement(character)

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid or not root then
		return
	end

	humanoid.WalkSpeed =
		WALK_SPEED

	humanoid.AutoRotate =
		true

	humanoid.JumpPower =
		0

	humanoid.UseJumpPower =
		true

	humanoid:SetStateEnabled(
		Enum.HumanoidStateType.Jumping,
		false
	)

	local tracks =
		setupAnimationSystem(
			character
		)

	movementToken += 1

	local myToken =
		movementToken

	task.spawn(function()

		while character.Parent
			and humanoid.Health > 0
			and myToken == movementToken do

			if not movementEnabled then

				humanoid:Move(
					Vector3.zero,
					false
				)

				playIdle(tracks)

				task.wait(0.5)

				continue

			end

			playIdle(tracks)

			local idleTime =
				math.random(2, 4)

			local idleStart =
				os.clock()

			while os.clock()
				- idleStart < idleTime do

				if not movementEnabled then
					break
				end

				if myToken ~= movementToken then
					return
				end

				task.wait(0.2)

			end

			if not movementEnabled then
				continue
			end

			if myToken ~= movementToken then
				return
			end

			local angle =
				math.random()
				* math.pi
				* 2

			local distance =
				math.random(10, 22)

			local destination =
				root.Position
				+ Vector3.new(
					math.cos(angle)
						* distance,
					0,
					math.sin(angle)
						* distance
				)

			playWalk(tracks)

			walkToPosition(
				character,
				destination,
				myToken
			)

			if character.Parent
				and humanoid.Health > 0 then

				humanoid:Move(
					Vector3.zero,
					false
				)

				playIdle(tracks)

			end

			task.wait(
				math.random(1, 3)
			)

		end

	end)

end

