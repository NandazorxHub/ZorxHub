local function AutoJoin()
    if running or teleporting then return end
    running = true
    selectedServer = nil

    ScanBtn.Active = false
    AutoBtn.Active = false
    JoinBtn.Active = false
    AutoBtn.Text = "⛔ STOP AUTO"

    SetStatus("⚡ AUTO LOCK SPAWN AKTIF\nCari divine/secret/eternal terbesar")

    task.spawn(function()
        while running do
            CleanBlacklist()

            SetStatus("🔎 SCAN SERVER 1 PLAYER...")
            local found = Scan()

            if not found then
                SetStatus("⏳ TIDAK ADA SERVER\nTunggu " .. AUTO_SCAN_DELAY .. "s...")
                task.wait(AUTO_SCAN_DELAY)
                continue
            end

            local targets = {}
            for jid, data in pairs(Candidates) do
                if not IsBlacklisted(jid) and not IsRecentlyFailed(jid) then
                    local scanData = ServerScanResults[jid]
                    if not scanData or scanData.size > CURRENT_TARGET_SIZE then
                        table.insert(targets, { jid = jid, score = data.eggScore or 0 })
                    end
                end
            end
            table.sort(targets, function(a, b) return a.score > b.score end)

            local gotIt = false
            for _, entry in ipairs(targets) do
                if not running then break end

                local canGo, reason = CanTeleportNow()
                if not canGo then
                    SetStatus("🛡️ TUNGGU COOLDOWN\n" .. (reason or ""))
                    local waited = 0
                    while running and waited < 90 do
                        if CanTeleportNow() then break end
                        task.wait(0.5)
                        waited += 0.5
                    end
                    if not running then break end
                end

                SetStatus("⚡ COBA SERVER: " .. math.floor(entry.score) ..
                    "\n🎯 TARGET SIZE: " .. math.floor(CURRENT_TARGET_SIZE))

                local ok = JoinAndVerify(entry.jid)
                if ok then
                    gotIt = true
                    break
                end

                if not running then break end
                task.wait(TELEPORT_QUEUE_DELAY)
            end

            if gotIt then
                SetStatus("🎉 DAPAT!\n🔒 TETAP DI SERVER INI")
                running = false
                break
            end

            if running then
                SetStatus("🔎 SEMUA SUDAH DICOBA\nScan ulang cari yang lebih gede...")
                task.wait(AUTO_SCAN_DELAY)
            end
        end

        running = false
        ScanBtn.Active = true
        AutoBtn.Active = true
        JoinBtn.Active = true
        AutoBtn.Text = "⚡ AUTO LOCK SPAWN"
    end)
end

