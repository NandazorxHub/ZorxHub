local function CleanTeleportHistory()
    local now = os.clock()
    local newHistory = {}
    for _, t in ipairs(teleportHistory) do
        if now - t < 300 then
            table.insert(newHistory, t)
        end
    end
    teleportHistory = newHistory
end

local function CanTeleportNow()
    if TELEPORT_LOCK then return false, "Sedang proses" end
    CleanTeleportHistory()
    local now = os.clock()

    local sinceLast = now - lastTeleportTime
    if sinceLast < TELEPORT_COOLDOWN then
        return false, "Tunggu " .. string.format("%.1f", TELEPORT_COOLDOWN - sinceLast) .. "s"
    end

    local count1min = 0
    local oldestInWindow = nil
    for _, t in ipairs(teleportHistory) do
        if now - t < 60 then
            count1min += 1
            if not oldestInWindow or t < oldestInWindow then
                oldestInWindow = t
            end
        end
    end
    if count1min >= MAX_TELEPORT_PER_MINUTE then
        local waitTime = 60 - (now - (oldestInWindow or now))
        return false, "Limit/menit — tunggu " .. string.format("%.0f", math.max(waitTime, 1)) .. "s"
    end

    if #teleportHistory >= MAX_TELEPORT_PER_5MIN then
        local oldest = teleportHistory[1] or now
        local waitTime = 300 - (now - oldest)
        return false, "Limit/5menit — tunggu " .. string.format("%.0f", math.max(waitTime, 1)) .. "s"
    end

    return true, nil
end

local function WaitUntilTeleportAllowed()
    while true do
        if TELEPORT_LOCK then task.wait(0.3)
        else
            local ok, reason = CanTeleportNow()
            if ok then return true end
            SetStatus("🛡️ TUNGGU\n" .. reason)
        end
        if not running and not teleporting then return false end
        task.wait(0.5)
    end
end

local function RecordTeleportAttempt()
    lastTeleportTime = os.clock()
    table.insert(teleportHistory, os.clock())
    CleanTeleportHistory()
end

