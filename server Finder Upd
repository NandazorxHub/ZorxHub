local function WaitForBestEgg()
    local startWait = os.clock()
    local bestLockedFound = nil
    local bestNormalFound = nil

    while (os.clock() - startWait) < EGG_CHECK_WAIT do
        local best, hasLocked, normal = ScanBiggestEggInWorkspace()

        if best then
            local v = best.sizeVec or Vector3.new()
            local sizeStr = string.format("%.1f × %.1f × %.1f", v.X, v.Y, v.Z)
            local tonStr = string.format("%.2f", best.weightKG / 1000)

            if hasLocked then
                bestLockedFound = best
                SetStatus("🔒 " .. string.upper(best.tier) .. " SPAWN!\n" ..
                    best.name ..
                    "\n📏 " .. sizeStr ..
                    "\n⚖️ " .. tonStr .. " TON")
            else
                bestNormalFound = best
                SetStatus("🥚 PALING BESAR: " .. best.name ..
                    "\n📏 " .. sizeStr ..
                    "\n⚖️ " .. tonStr .. " TON" ..
                    "\n⏳ Tunggu divine/secret/eternal...")
            end
        end
        task.wait(EGG_CHECK_INTERVAL)
    end

    if bestLockedFound then return true, bestLockedFound, true end
    if bestNormalFound then return true, bestNormalFound, false end
    return false, nil, false
end

local function FindNextTarget(excludeJid)
    local bestJid = nil
    local bestScore = -1
    for jid, data in pairs(Candidates) do
        if jid ~= excludeJid
            and not IsBlacklisted(jid)
            and not IsRecentlyFailed(jid)
            and (data.eggScore or 0) > bestScore
        then
            bestScore = data.eggScore
            bestJid = jid
        end
    end
    return bestJid
end

-- =========================================================
-- 🔒 JOIN & VERIFY — LOCK SPAWN DIVINE/SECRET/ETERNAL TERBESAR
-- =========================================================

local function JoinAndVerify(jid)
    local success = TeleportToServer(jid)
    if not success then
        Blacklist[jid] = os.clock() + FAILED_SERVER_DURATION
        recentFailedServers[jid] = os.clock()
        return false
    end

    task.wait(1.5)
    SetStatus("🔍 TUNGGU SPAWN TELUR...")

    local found, bestEgg, isLocked = WaitForBestEgg()

    -- ❌ GA ADA SPAWN SAMA SEKALI → SKIP
    if not found then
        Blacklist[jid] = os.clock() + 30
        totalSkipped += 1
        UpdateInfo()
        SetStatus("❌ GA ADA SPAWN\nPindah server RNG berikutnya...")
        return false
    end

    local v = bestEgg.sizeVec or Vector3.new()
    local sizeStr = string.format("%.1f × %.1f × %.1f", v.X, v.Y, v.Z)
    local volume = bestEgg.volume or 0
    local weightTon = bestEgg.weightKG / 1000

    ServerScanResults[jid] = {
        size = volume,
        sizeVec = v,
        tier = bestEgg.tier,
        weightKG = bestEgg.weightKG,
        name = bestEgg.name,
        isLocked = isLocked,
        timestamp = os.clock(),
    }

    local shouldLock = false
    local reason = ""

    if isLocked then
        -- 🔒 DIVINE/SECRET/ETERNAL SPAWN → WAJIB TETAP
        shouldLock = true
        reason = "🔒 " .. string.upper(bestEgg.tier) .. " SPAWN!"

        if volume > BestEverSize then
            BestEverSize = volume
            BestEverServer = jid
            CURRENT_TARGET_SIZE = volume
        end
    elseif volume > CURRENT_TARGET_SIZE and volume >= MIN_SIZE_TO_KEEP then
        shouldLock = true
        reason = "📏 SIZE TERBESAR BARU!"
        CURRENT_TARGET_SIZE = volume
        BestEverSize = volume
        BestEverServer = jid
    else
        shouldLock = false
        reason = "⏭️ SIZE " .. math.floor(volume) ..
            " < TARGET " .. math.floor(CURRENT_TARGET_SIZE)
    end

    if shouldLock then
        local tonStr = string.format("%.2f", weightTon)
        if isLocked then
            SetStatus("🎉 LOCK!\n🔒 " .. string.upper(bestEgg.tier) .. " SPAWN!\n" ..
                bestEgg.name ..
                "\n📏 " .. sizeStr ..
                "\n⚖️ " .. tonStr .. " TON\n✅ TETAP DI SINI")
        else
            SetStatus("✅ SIZE TERBESAR!\n" .. bestEgg.name ..
                "\n📏 " .. sizeStr ..
                "\n⚖️ " .. tonStr .. " TON\n✅ TETAP DI SINI")
        end

        UpdateServerList()
        return true
    else
        SetStatus("⏭️ SKIP SERVER INI\n" .. reason ..
            "\n📏 " .. sizeStr ..
            "\n⚖️ " .. string.format("%.2f", weightTon) .. " TON\nCari yang lebih gede...")
        Blacklist[jid] = os.clock() + 30
        totalSkipped += 1
        UpdateInfo()
        UpdateServerList()
        return false
    end
end

