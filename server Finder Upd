local function UpdateServerList()
    ClearServerList()
    local sorted = {}
    for jid, data in pairs(Candidates) do
        if not IsBlacklisted(jid) and not IsRecentlyFailed(jid) then
            local scanData = ServerScanResults[jid]
            table.insert(sorted, {
                jid = jid,
                data = data,
                scanData = scanData,
            })
        end
    end

    table.sort(sorted, function(a, b)
        local aSize = a.scanData and a.scanData.size or 0
        local bSize = b.scanData and b.scanData.size or 0
        if aSize ~= bSize then return aSize > bSize end
        return (a.data.eggScore or 0) > (b.data.eggScore or 0)
    end)

    BestServer = sorted[1] and sorted[1].jid or nil

    local count = 0
    for _, entry in ipairs(sorted) do
        if count >= MAX_DISPLAY_SERVERS then break end
        local isBest = (entry.jid == BestServer)
        AddServer(entry.jid, entry.data, isBest, entry.scanData)
        count += 1
    end
    UpdateInfo()
end

