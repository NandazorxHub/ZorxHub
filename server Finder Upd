local function IsEggAvailable(obj)
    local ok, transparency = pcall(function() return obj.Transparency end)
    if ok and transparency and transparency >= 1 then return false end
    if obj:IsDescendantOf(game.Players) then return false end

    local takenAttr = obj:GetAttribute("Taken") or obj:GetAttribute("Claimed")
        or obj:GetAttribute("TakenBy") or obj:GetAttribute("Owner")
    if takenAttr ~= nil then
        if typeof(takenAttr) == "boolean" and takenAttr then return false end
        if typeof(takenAttr) == "string" and takenAttr ~= "" then return false end
    end

    local parent = obj.Parent
    if parent and (parent:IsA("Tool") or parent:IsA("Accessory")) then return false end

    if obj:IsA("BasePart") then
        local ok2, vel = pcall(function() return obj.AssemblyLinearVelocity end)
        if ok2 and vel and vel.Magnitude > 50 then return false end
    end

    return true
end

local UNIT_TO_KG = {
    ["kg"] = 1, ["kilogram"] = 1, ["kilograms"] = 1,
    ["g"] = 0.001, ["gram"] = 0.001, ["grams"] = 0.001,
    ["t"] = 1000, ["ton"] = 1000, ["tons"] = 1000, ["tonne"] = 1000, ["tonnes"] = 1000,
    ["lb"] = 0.453592, ["lbs"] = 0.453592, ["pound"] = 0.453592, ["pounds"] = 0.453592,
    ["oz"] = 0.0283495, ["ounce"] = 0.0283495, ["ounces"] = 0.0283495,
    ["st"] = 6.35029, ["stone"] = 6.35029,
    ["kt"] = 1000000, ["megaton"] = 1000000, ["mt"] = 1000000,
    ["kw"] = 100, ["kuintal"] = 100, ["quintal"] = 100, ["qt"] = 100,
}

local function ExtractWeightFromName(name)
    if not name or name == "" then return 0 end
    local n = string.lower(tostring(name))
    local best = 0

    for num, unit in string.gmatch(n, "(%d+%.?%d*)%s*([a-z]+)") do
        local val = tonumber(num)
        if val and UNIT_TO_KG[unit] then
            local kg = val * UNIT_TO_KG[unit]
            if kg > best then best = kg end
        end
    end

    if best == 0 then
        local num = tonumber(string.match(n, "(%d+%.?%d*)"))
        if num and num > 0 then
            best = num
        end
    end

    return best
end

local function GetTrueSize(obj)
    local sx, sy, sz = 1, 1, 1
    local found = false

    if obj:IsA("BasePart") then
        sx = obj.Size.X
        sy = obj.Size.Y
        sz = obj.Size.Z
        found = true
    end

    local mesh = obj:FindFirstChildOfClass("SpecialMesh")
        or obj:FindFirstChildOfClass("Mesh")
        or obj:FindFirstChildOfClass("CylinderMesh")
        or obj:FindFirstChildOfClass("BlockMesh")
        or obj:FindFirstChildOfClass("SphereMesh")
        or obj:FindFirstChildOfClass("WedgeMesh")
    if mesh then
        sx *= mesh.Scale.X
        sy *= mesh.Scale.Y
        sz *= mesh.Scale.Z
        found = true
    end

    if obj:IsA("Model") then
        local ok, sc = pcall(function() return obj:GetScale() end)
        if ok and sc then
            sx *= sc.X
            sy *= sc.Y
            sz *= sc.Z
            found = true
        end
        local ok2, ext = pcall(function() return obj:GetExtentsSize() end)
        if ok2 and ext then
            sx = math.max(sx, ext.X)
            sy = math.max(sy, ext.Y)
            sz = math.max(sz, ext.Z)
            found = true
        end
    end

    if not obj:IsA("BasePart") then
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("BasePart") then
                local dsize = d.Size
                local dm = d:FindFirstChildOfClass("SpecialMesh")
                    or d:FindFirstChildOfClass("Mesh")
                if dm then
                    dsize = Vector3.new(
                        dsize.X * dm.Scale.X,
                        dsize.Y * dm.Scale.Y,
                        dsize.Z * dm.Scale.Z
                    )
                end
                sx = math.max(sx, dsize.X)
                sy = math.max(sy, dsize.Y)
                sz = math.max(sz, dsize.Z)
                found = true
            end
        end
    end

    if not found then return 0, Vector3.new() end
    return sx * sy * sz, Vector3.new(sx, sy, sz)
end

