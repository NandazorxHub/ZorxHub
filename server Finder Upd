local function HashJID(jid)
    local hash = 0
    for i = 1, #jid do
        hash = (hash * 31 + string.byte(jid, i)) % 1000000
    end
    return hash
end

local function PredictEggScore(jid, serverData)
    local hash = HashJID(jid)
    local rngBase = 50 + (hash % 50)

    local region = string.lower(tostring(serverData.region or ""))
    local regionBonus = 0
    for r, val in pairs(PREFERRED_REGIONS) do
        if string.find(region, r) then regionBonus = val break end
    end

    local uptime = serverData.uptime or 0
    local uptimeBonus = uptime < 200 and 20 or uptime < 900 and 12 or uptime < 2000 and 5 or 0

    local ping = serverData.ping or 999
    local pingBonus = ping < 50 and 12 or ping < 90 and 8 or ping < 140 and 4 or 0

    return math.min(rngBase + regionBonus + uptimeBonus + pingBonus, 250)
end

