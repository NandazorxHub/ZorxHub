-- 🔒 SCAN SAAT SPAWN — DIVINE/SECRET/ETERNAL PALING GEDE
-- =========================================================

local function ScanBiggestEggInWorkspace()
    local lockedEggs = {}
    local normalEggs = {}

    local seen = {}

    local function checkChildren(parent, depth)
        if depth > 6 then return end
        for _, child in ipairs(parent:GetChildren()) do
            if seen[child] then continue end
            seen[child] = true

            local egg = ScoreEgg(child)
            if egg then
                if egg.isRare then
                    table.insert(lockedEggs, egg)
                else
                    table.insert(normalEggs, egg)
                end
            end

            if child:IsA("Model") or child:IsA("Folder")
                or child:IsA("Tool") or child:IsA("Accessory") then
                checkChildren(child, depth + 1)
            end
        end
    end

    local found = false
    for _, obj in ipairs(game.Workspace:GetChildren()) do
        local lname = string.lower(obj.Name)
        for _, key in ipairs(EGG_FOLDER_NAMES) do
            if string.find(lname, key, 1, true) then
                checkChildren(obj, 1)
                found = true
                break
            end
        end
    end
    if not found then checkChildren(game.Workspace, 0) end

    local bestLocked = nil
    local bestNormal = nil

    if #lockedEggs > 0 then
        table.sort(lockedEggs, function(a, b)
            if a.lockedRank ~= b.lockedRank then
                return a.lockedRank > b.lockedRank
            end
            return a.mainScore > b.mainScore
        end)
        bestLocked = lockedEggs[1]
    end

    if #normalEggs > 0 then
        table.sort(normalEggs, function(a, b)
            return a.mainScore > b.mainScore
        end)
        bestNormal = normalEggs[1]
    end

    local result = bestLocked or bestNormal
    local hasLocked = (bestLocked ~= nil)
    BestEgg = result
    return result, hasLocked, bestNormal
end

