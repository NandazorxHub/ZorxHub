local function TeleportToServer(jid)
    if not jid or IsBlacklisted(jid) or IsRecentlyFailed(jid) then return false end

    local allowed = WaitUntilTeleportAllowed()
    if not allowed then return false end

    TELEPORT_LOCK = true
    teleporting = true
    totalTry += 1
    UpdateInfo()

    local eggScore = ServerEggScores[jid] or 0
    SetStatus("🚀 MASUK SERVER...\nRNG WANGI: " .. math.floor(eggScore))

    RecordTeleportAttempt()

    local failed = false
    local errorMessage
    local rateLimited = false

    local connection
    connection = TeleportService.TeleportInitFailed:Connect(function(player, _, err)
        if player == LocalPlayer then
            failed = true
            errorMessage = tostring(err)
            rateLimited = IsRateLimitError(errorMessage)
            if connection then connection:Disconnect() connection = nil end
        end
    end)

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, jid, LocalPlayer)
    end)

    if not ok then
        if connection then connection:Disconnect() end
        teleporting = false
        TELEPORT_LOCK = false
        recentFailedServers[jid] = os.clock()

        if IsRateLimitError(err) then
            ForceCooldown(TELEPORT_COOLDOWN_AFTER_769)
            SetStatus("🛡️ 769/722 — TUNGGU " .. TELEPORT_COOLDOWN_AFTER_769 .. "s")
            Blacklist[jid] = os.clock() + FAILED_SERVER_DURATION
        else
            ForceCooldown(TELEPORT_COOLDOWN_AFTER_FAIL)
            SetStatus("❌ GAGAL — " .. tostring(err))
            Blacklist[jid] = os.clock() + FAILED_SERVER_DURATION
        end
        return false
    end

    for _ = 1, TELEPORT_WAIT do
        task.wait(0.05)
        if failed then
            if connection then connection:Disconnect() end
            teleporting = false
            TELEPORT_LOCK = false
            recentFailedServers[jid] = os.clock()
            if rateLimited then
                ForceCooldown(TELEPORT_COOLDOWN_AFTER_769)
                SetStatus("🛡️ LIMIT — TUNGGU " .. TELEPORT_COOLDOWN_AFTER_769 .. "s")
            else
                ForceCooldown(TELEPORT_COOLDOWN_AFTER_FAIL)
                SetStatus("❌ PENUH — PINDAH OTOMATIS")
            end
            Blacklist[jid] = os.clock() + FAILED_SERVER_DURATION
            return false
        end
        if game.JobId == jid then
            if connection then connection:Disconnect() end
            totalOK += 1
            UpdateInfo()
            SetStatus("✅ MASUK!\nTunggu spawn telur...")
            TELEPORT_LOCK = false
            return true
        end
    end

    if connection then connection:Disconnect() end
    teleporting = false
    TELEPORT_LOCK = false
    recentFailedServers[jid] = os.clock()
    ForceCooldown(TELEPORT_COOLDOWN_AFTER_FAIL)
    Blacklist[jid] = os.clock() + FAILED_SERVER_DURATION
    SetStatus("❌ TIMEOUT")
    return false
end

