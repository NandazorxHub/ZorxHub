-- =========================================================
-- 🔒 SCORE EGG — DIVINE/SECRET/ETERNAL LOCK MUTLAK
-- =========================================================

local function ScoreEgg(obj)
    if not IsEggAvailable(obj) then return nil end

    local name = string.lower(obj.Name)
    local isEggNamed = false
    for _, w in ipairs(EGG_WORDS) do
        if string.find(name, w, 1, true) then isEggNamed = true break end
    end

    local tier = "unknown"
    local lockedRank = 0
    local isLocked = false

    for kw, rank in pairs(LOCKED_RARE) do
        if string.find(name, kw, 1, true) then
            tier = kw
            lockedRank = rank
            isLocked = true
            break
        end
    end

    if not isLocked then
        for _, keyword in ipairs(EGG_PRIORITY) do
            if string.find(name, keyword, 1, true) then
                tier = keyword
                break
            end
        end
    end

    local volume, vec = GetTrueSize(obj)

    if not isEggNamed and volume < 5 then return nil end
    if volume <= 0 then return nil end

    local weightKG = ExtractWeightFromName(obj.Name)
    if weightKG <= 0 then
        weightKG = volume
    end

    local mainScore
    if isLocked then
        mainScore = lockedRank * 1e15 + volume * 1000 + weightKG
    else
        mainScore = volume * 1000 + weightKG
    end

    return {
        name = obj.Name,
        tier = tier,
        weightKG = weightKG,
        volume = volume,
        sizeVec = vec,
        object = obj,
        isRare = isLocked,
        lockedRank = lockedRank,
        mainScore = mainScore,
    }
end

